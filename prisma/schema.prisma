enum Role {
  STUDENT
  JURY
  ADMIN
}

enum IaModel {
  MISTRAL
  GEMINI
  O1
  O4
  CLAUDE
}

enum Levels {
  L1
  L2
  L3
  M1
  M2
  D1
  D2
  D3
}

enum Task {
  LINKEDIN
  GRAPHIC
  COMMUNICATION
}






















// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  STUDENT
  JURY
  ADMIN
}

enum Levels {
  L1
  L2
  L3
  M1
  M2
  D1
  D2
  D3
}

enum Task {
  LINKEDIN
  GRAPHIC
  COMMUNICATION
}

model User {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  isActive                Boolean   @default(false)
  role                    Role?
  firstname               String?
  lastname                String?
  age                     Int?
  email                   String    @unique
  emailToken              String?
  firstConnexion          Boolean?  @default(true)
  password                String?
  passwordToken           String?
  passwordTokenExpiration DateTime?
  experienceTime          Float?
  etpNumber               Float?
  activityType            String?
  currentPosition         String?
  lastDegree              String?
  studyType               String?
  studentLevel            Levels?
  credit                  Int       @default(100)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  globalTokens GlobalTokens?
  autoEvals    AutoEval[]
  group        Group?        @relation(fields: [groupId], references: [id])
  groupId      String?       @db.ObjectId
  convs        Conv[]
  chats        Chat[]
}

model GlobalTokens {
  id      String @id @default(auto()) @map("_id") @db.ObjectId
  mistral Int?   @default(0)
  gemini  Int?   @default(0)
  chatGpt Int?   @default(0)

  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model Group {
  id    String  @id @default(auto()) @map("_id") @db.ObjectId
  name  String?
  users User[]
  convs Conv[]
}

model AutoEval {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  task   Task?
  note   Int?
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

model Conv {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  createdAt DateTime @default(now())
  teamId    String?
  task      Task?
  comment   String?
  question  String?
  note      Int?
  userId    String?  @db.ObjectId
  user      User?    @relation(fields: [userId], references: [id])
  groupId   String?  @db.ObjectId
  group     Group?   @relation(fields: [groupId], references: [id])
  chats     Chat[]
}

model Chat {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  prompt           String
  answer           String
  model            String
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?
  comment          String?
  question         String?
  note             Int?
  createdAt        DateTime @default(now())

  convId String @db.ObjectId
  conv   Conv   @relation(fields: [convId], references: [id])
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
}

