// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  firstname               String
  lastname                String
  age                     Int
  experienceTime          Float
  etpNumber               Float
  activityType            String
  currentPosition         String
  lastDegree              String?
  email                   String    @unique
  emailToken              String?
  password                String?
  passwordToken           String?
  passwordTokenEXPIRATION DateTime?
  role                    Role
  firstConnexion          Boolean?
  isActive                Boolean   @default(false)
  note                    Int?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @default(now())
  credit                  Int       @default(100)
  studentLevel            Levels
  studyType               String
  teamName                String
  chat                    Chat[]
  // comment                 Comment[]
}

model Chat {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  fullConvId   String?
  user         User?    @relation(fields: [userId], references: [id])
  userId       String?  @db.ObjectId
  prompt       String?
  answer       String?
  model        IaModel?
  createdAt    DateTime @default(now())
  taskType     Task?
  finishedConv Boolean?
}

model Comment {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  fullConvId  String
  textComment String
}

enum Role {
  STUDENT
  JURY
  ADMIN
}

enum IaModel {
  MISTRAL
  GEMINI
  O1
  O4
  CLAUDE
}

enum Levels {
  L1
  L2
  L3
  M1
  M2
  D1
  D2
  D3
}

enum Task {
  LINKEDIN
  GRAPHIC
  COMMUNICATION
}
