generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model User {
  id                      String     @id @default(auto()) @map("_id") @db.ObjectId
  isActive                Boolean    @default(false)
  role                    Role
  firstname               String?
  lastname                String?
  age                     Int        @default(0)
  email                   String     @unique
  emailToken              String?
  firstConnexion          Boolean?
  password                String?
  passwordToken           String?
  passwordTokenEXPIRATION DateTime?
  experienceTime          Float      @default(0)
  etpNumber               Float      @default(0)
  activityType            String?
  currentPosition         String?
  lastDegree              String?
  studyType               String?
  studentLevel            String?
  createdAt               DateTime   @default(now())
  updatedAt               DateTime   @default(now())
  credit                  Int        @default(100)
  autoEval                AutoEval[]
  group                   Group[]
  conv                    Conv[]
}

type Group {
  id   String?
  name String?
}

type AutoEval {
  id   String?
  task Task?
  note Int?
}

type Conv {
  id        String?
  createdAt DateTime @default(now())
  teamId    String?
  task      Task?
  comment   String?
  question  String?
  note      Int?
  chat      Chat[]
}

type Chat {
  id        String?
  prompt    String?
  answer    String?
  model     String?
  createdAt DateTime @default(now())
  comment   String?
  question  String?
  note      Int?
}

