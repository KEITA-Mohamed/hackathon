model Group {
  id     String  @id @default(auto()) @map("_id") @db.ObjectId
  user   User    @relation(fields: [userId], references: [id])
  userId String  @db.ObjectId
  name   String?
}

model AutoEval {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])
  userId String @db.ObjectId
  task   Task?
  note   Int?
}

model Conv {
  id       String  @id @default(auto()) @map("_id") @db.ObjectId
  user     User    @relation(fields: [userId], references: [id])
  userId   String  @db.ObjectId
  teamId   String?
  task     Task?
  comment  String?
  question String?
  note     Int?
  chat     Chat[]
}

model Chat {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  conv      Conv     @relation(fields: [convId], references: [id])
  convId    String   @db.ObjectId
  prompt    String?
  answer    String?
  model     IaModel?
  createdAt DateTime @default(now())
  comment   String?
  question  String?
  note      Int?
  User      User?    @relation(fields: [userId], references: [id])
  userId    String?  @db.ObjectId
}

enum Role {
  STUDENT
  JURY
  ADMIN
}

enum IaModel {
  MISTRAL
  GEMINI
  O1
  O4
  CLAUDE
}

enum Levels {
  L1
  L2
  L3
  M1
  M2
  D1
  D2
  D3
}

enum Task {
  LINKEDIN
  GRAPHIC
  COMMUNICATION
}
